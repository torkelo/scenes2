{
  "name": "@grafana/scenes2",
  "version": "0.0.0",
  "private": false,
  "description": "Grafana scenes v2",
  "license": "Apache-2.0",
  "author": "Grafana Labs",
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.cts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm clean && pnpm build:ts && pnpm build:rollup",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:rollup": "rollup -c rollup.config.ts --configPlugin esbuild",
    "clean": "rm -rf dist compiled .turbo tsconfig.tsbuildinfo",
    "dev": "tsc -p tsconfig.dev.json --watch --preserveWatchOutput",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "motion": "^12.40.0 || ^13.0.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "6.30.6"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@grafana/data": "^13.2.0",
    "@grafana/runtime": "^13.2.0",
    "@grafana/schema": "^13.2.0",
    "@grafana/ui": "^13.2.0",
    "@tanstack/react-query": "^5.102.0",
    "lodash": "4.17.21",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@storybook/react": "10.5.9",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/jsdom": "30.0.0",
    "@types/lodash": "4.14.187",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "motion": "^13.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "rollup": "4.62.4",
    "rollup-plugin-dts": "6.5.1",
    "rollup-plugin-esbuild": "6.2.1",
    "rollup-plugin-node-externals": "9.0.1",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/torkelo/scenes2.git",
    "directory": "packages/scenes2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
