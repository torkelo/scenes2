{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "declarationDir": "./compiled",
    "emitDeclarationOnly": true,
    "noEmit": false,
    "composite": false
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "compiled",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/test/**"
  ]
}
