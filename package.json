{
  "name": "grafana-design",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.15",
    "pnpm": ">=11.8.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "e2e:scenarios": "turbo run e2e --filter @grafana/scenarios",
    "preflight": "./scripts/preflight.sh",
    "link-workspace": "./scripts/link-workspace.sh",
    "unlink-workspace": "./scripts/unlink-workspace.sh",
    "dev": "turbo run dev",
    "prepare": "git config core.hooksPath .githooks || true",
    "gen": "turbo gen",
    "hatch:gen": "hatch gen -targets claude,codex,cursor && node scripts/sync-bundled-skills.mjs && prettier --write --ignore-unknown AGENTS.md CLAUDE.md .hatch .agents .cursor .claude/skills .claude/commands 'packages/*/AGENTS.md' 'packages/*/CLAUDE.md'",
    "hatch:check": "pnpm hatch:gen && git diff --exit-code",
    "version-packages": "changeset version && prettier --write '.changeset/**' '**/package.json' '**/CHANGELOG.md'",
    "release": "turbo run build && changeset publish",
    "version:beta": "changeset version --snapshot beta",
    "release:beta": "turbo run build && changeset publish --tag beta --no-git-tag",
    "storybook": "pnpm turbo run storybook --filter=@grafana/storybook"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.117.1",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.0",
    "@emotion/eslint-plugin": "^11.12.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@turbo/gen": "2.10.10",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "change-case": "5.4.4",
    "colors": "1.4.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-css": "^0.12.0",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "handlebars": "4.7.9",
    "http-server": "^14.1.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "svgo": "4.0.2",
    "tsx": "4.23.12",
    "turbo": "2.10.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.67.0"
  }
}
